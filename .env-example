# Thief agent — secret placeholders. Copy to `.env` (git-ignored) and fill in locally.
# NEVER commit `.env`, `credentials.json` or `token.json`; all three are in .gitignore.
#
# Nothing here is required for the default run. The agent plays a full six-sub-game series
# offline with zero secrets: hints come from offline templates and every move is decided in
# Python. These variables only switch on optional layers.

# ---------------------------------------------------------------------------
# Optional tactical advisor (OpenAI). Disabled unless OPENAI_ADVISOR=1.
# Counted-match evidence in docs/evidence/ was played with this OFF (0 tokens).
# ---------------------------------------------------------------------------
OPENAI_ADVISOR=0                 # 1 enables the advisor; anything else disables it
OPENAI_API_KEY=                  # required only when OPENAI_ADVISOR=1
OPENAI_MODEL=                    # optional model override; empty uses the built-in default
OPENAI_ADVISOR_POLICY=           # optional A/B/C policy selector; empty uses the default

# ---------------------------------------------------------------------------
# Optional Gmail result reporting (Appendix A). Needs `uv sync --extra gmail`.
# Send-only OAuth scope; see docs/GMAIL-OAUTH.md.
# ---------------------------------------------------------------------------
PT_GMAIL_MODE=draft              # draft (the default) never sends; set to send for a real send
PT_GMAIL_CREDENTIALS=credentials.json   # path to the OAuth client file (git-ignored)
PT_GMAIL_TOKEN=token.json               # path to the cached OAuth token (git-ignored)
PT_GMAIL_RECIPIENT=              # empty uses the rulebook's agent-report address

# ---------------------------------------------------------------------------
# Networked play
# ---------------------------------------------------------------------------
PT_TUNNEL_URL=                   # public MCP URL for this peer, e.g. https://<host>/mcp
PT_SIGNER_KEY=                   # HMAC key for artifact signing; empty uses the dev-test signer

# ---------------------------------------------------------------------------
# Strategy overrides (see Appendix F Table 22). Empty means "use the tuned default".
# ---------------------------------------------------------------------------
POLICE_STRATEGY=
THIEF_STRATEGY=

